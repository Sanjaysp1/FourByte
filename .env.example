# ─────────────────────────────────────────────────────────────────────────────
# NexusAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── SECURITY ──────────────────────────────────────────────────────────────────
# Generate a strong secret key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-key

# ── OPTIONAL — override defaults ──────────────────────────────────────────────
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004
# DATABASE_URL=sqlite+aiosqlite:///./nexusai.db
# CHROMA_PERSIST_DIR=./chroma_db
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE_MB=20
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K_RESULTS=5
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
